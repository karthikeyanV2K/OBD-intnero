#!/usr/bin/env node

/**
 * Overdrive AI Agent - CLI Entry Point
 * Global command: `overdrive` (after npm install -g)
 * Local command: `npm run cli` or `node bin/overdrive`
 */

const fs = require('fs');
const path = require('path');
const CLI = require('../lib/cli');

const cli = new CLI();

// Get command and args
const command = process.argv[2] || 'help';
const args = process.argv.slice(3);

// Run command
cli.execute(command, args).catch(err => {
  console.error('\n❌ Error:', err.message);
  process.exit(1);
});
