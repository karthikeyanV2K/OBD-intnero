{
  "manifest_version": 3,
  "name": "OverDrive AI Agent",
  "version": "1.0.0",
  "description": "Unified AI agent with persistent memory — works on GitHub, GitLab, and any localhost page. Shares context with VS Code, Cursor, Windsurf, Kiro, and Claude Desktop.",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus"],
  "host_permissions": [
    "https://github.com/*",
    "https://gitlab.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://github.com/*", "https://gitlab.com/*", "http://localhost/*"],
    "js": ["content.js"],
    "css": ["content.css"]
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OverDrive AI Agent",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
