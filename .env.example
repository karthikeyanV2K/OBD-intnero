# OverDrive AI Agent Configuration
# Set these environment variables before starting the server

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional: Default model
DEFAULT_MODEL=claude-sonnet-4-6

# Optional: Default model
DEFAULT_MODEL=claude-sonnet-4-6

# Optional: Tag which IDE is using the agent (stamped on every graph node)
OVERDRIVE_IDE=Kiro

# Optional: Enable Vector DB for semantic search (OFF by default, set to 1 to enable)
OVERDRIVE_VECTOR=0

# Optional: Database paths (default: current directory)
GRAPH_DB_PATH=agent-graph.odb
VECTOR_DB_PATH=agent-vectors.odb
TIMESERIES_DB_PATH=agent-metrics.odb
STREAMING_DB_PATH=agent-stream.odb
RAM_DB_PATH=agent-session.odb
DISK_DB_PATH=agent-knowledge.odb
