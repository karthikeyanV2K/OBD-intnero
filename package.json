{
  "name": "odb-echograph",
  "version": "1.0.16",
  "description": "Unified AI coding agent with MCP integration for Claude, VS Code, and Kiro IDE. Features persistent knowledge graph via OverdriveDB, token compression (60-80%), multi-model switching, and shared/independent project modes.",
  "main": "server.js",
  "bin": {
    "odb-dashboard": "bin/odb-dashboard.js"
  },
  "type": "commonjs",
  "preferGlobal": true,
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "dashboard": "node server.js",
    "mcp": "node mcp-server.js",
    "mcp-dev": "NODE_ENV=development node mcp-server.js",
    "worker": "node -e \"const {initAllEngines,getEngines}=require('./agent-db');const {startWorker}=require('./task-worker');(async()=>{await initAllEngines();await startWorker(0);})()\"",
    "dev": "concurrently \"npm run mcp\" \"npm run server\" \"npm run worker\"",
    "cli": "node bin/overdrive",
    "test": "node test/test-core.js && node test/test-unit.js && node test/test-integration.js && node test/test-api.js",
    "prepare": "npm run build",
    "build": "echo Build complete"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "model-context-protocol",
    "claude",
    "vs-code",
    "copilot",
    "kiro-ide",
    "overdrive-db",
    "knowledge-graph",
    "code-generation",
    "multi-model",
    "token-compression",
    "gpt-4",
    "anthropic"
  ],
  "author": {
    "name": "AFOT (All For One Tech)",
    "email": "your.email@example.com",
    "url": "https://github.com/yourusername"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/all_for_one_tech/odb-echograph.git"
  },
  "bugs": {
    "url": "https://github.com/all_for_one_tech/odb-echograph/issues"
  },
  "homepage": "https://github.com/all_for_one_tech/odb-echograph#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "cors": "^2.8.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "openai": "^4.0.0",
    "overdrive-db": "^2.4.6"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "bin/",
    "lib/",
    "mcp-server.js",
    "server.js",
    "agent-db.js",
    "knowledge.js",
    "prompt-builder.js",
    "model-router.js",
    "task-worker.js",
    ".env.example",
    "public/"
  ]
}
